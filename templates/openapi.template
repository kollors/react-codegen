import { defineConfig } from '@openapi-codegen/cli';
import { generateReactQueryComponents, generateSchemaTypes } from '@openapi-codegen/typescript';
import { existsSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const tempDir = %OUTPUT_DIR%;
const readGeneratedFile = (filename) => {
  const path = join(tempDir, filename);
  return existsSync(path) ? readFileSync(path, 'utf-8') : '';
};

const config = defineConfig({
  openapi: {
    from: %OPENAPI_SOURCE%,
    outputDir: tempDir,
    to: async(context) => {
      const { schemasFiles } = await generateSchemaTypes(context, { filenamePrefix: '' });
      await generateReactQueryComponents(context, { filenamePrefix: '', schemasFiles });

      const contextStr = readFileSync(join(tempDir, 'context.ts'), 'utf-8').replace('import { QueryOperation } from "./components";', '');
      const utilsStr = readFileSync(join(tempDir, 'utils.ts'), 'utf-8');
      const schemasStr = readFileSync(join(tempDir, 'schemas.ts'), 'utf-8');
      const parametersStr = readGeneratedFile('parameters.ts');
      const openapiFetcherStr = readFileSync(%FETCHER_PATH%, 'utf-8').replace('export ', '');

      const componentsStr = readFileSync(join(tempDir, 'components.ts'), 'utf-8')
        .replace(/import\s+\*\s+as\s+reactQuery\s+from\s+"@tanstack\/react-query";/g, 'import * as reactQuery from "@tanstack/react-query";')
        .replace(/import\s+\{\s*useContext,\s*Context,\s*queryKeyFn\s*}\s+from\s+"\.\/context";/g, '')
        .replace(/import\s+\{\s*deepMerge\s*}\s+from\s+"\.\/utils";/g, '')
        .replace(/import\s+type\s+\*\s+as\s+Schemas\s+from\s+"\.\/schemas";/g, '')
        .replace(/import\s+type\s+\*\s+as\s+Fetcher\s+from\s+"\.\/fetcher";/g, '')
        .replace(/import\s+\{\s*fetch\s*}\s+from\s+"\.\/fetcher";/g, '')
        .replace(/Schemas\./g, '')
        .replace(/Fetcher\./g, '')
        .replace(/fetch\s*</g, 'openapiFetcher<');

      const result = ['// @ts-nocheck', '/* eslint-disable */', parametersStr, schemasStr, openapiFetcherStr, contextStr, utilsStr, componentsStr].join('\n\n');

      writeFileSync(%FILENAME%, result, 'utf-8');
      rmSync(tempDir, { recursive: true });
    },
  },
});

export default config;
